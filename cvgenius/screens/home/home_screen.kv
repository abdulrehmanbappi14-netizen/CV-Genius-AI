#:kivy 2.3.1

<HomeScreen>:
    MDBoxLayout:
        orientation: "vertical"
        padding: "24dp"
        spacing: "16dp"

        MDLabel:
            text: "CV Genius AI"
            halign: "center"
            font_style: "H4"

        MDLabel:
            text: "Android CV & Resume Builder - project skeleton is running."
            halign: "center"
            theme_text_color: "Secondary"

        MDRectangleFlatButton:
            text: "Open Profile Editor"
            on_release: root.manager.current = "profile_editor"
