#:kivy 2.3.1

<EducationEditorScreen>:
    MDBoxLayout:
        orientation: "vertical"
        padding: "24dp"
        spacing: "16dp"

        MDLabel:
            text: "Education Editor"
            halign: "center"
            font_style: "H5"

        MDTextField:
            id: education_text
            hint_text: "Education entries"
            multiline: True
            max_height: "200dp"

        MDRectangleFlatButton:
            text: "Back to Profile Editor"
            on_release: root.back_to_profile_editor()
