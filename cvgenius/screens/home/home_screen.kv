#:kivy 2.3.1

<HomeScreen>:
    MDBoxLayout:
        orientation: "vertical"
        padding: "24dp"
        spacing: "16dp"

        MDLabel:
            text: "CV Genius AI"
            halign: "center"
            font_style: "H4"

        MDLabel:
            text: "Dashboard"
            halign: "center"
            theme_text_color: "Secondary"

        MDLabel:
            text: "Create, review, and refine your CV profile from one place."
            halign: "center"
            theme_text_color: "Secondary"

        MDBoxLayout:
            orientation: "horizontal"
            spacing: "12dp"
            size_hint_y: None
            height: "48dp"

            MDRectangleFlatButton:
                text: "Open Profile Editor"
                on_release: root.open_profile_editor()

            MDRectangleFlatButton:
                text: "Open Preview"
                on_release: root.open_template_preview()
