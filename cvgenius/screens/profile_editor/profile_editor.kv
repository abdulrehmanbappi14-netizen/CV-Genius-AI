#:kivy 2.3.1

<ProfileEditorScreen>:
    MDBoxLayout:
        orientation: "vertical"
        padding: "24dp"
        spacing: "16dp"

        MDLabel:
            text: "Profile Editor"
            halign: "center"
            font_style: "H5"

        MDTextField:
            id: full_name
            hint_text: "Full name"

        MDTextField:
            id: professional_title
            hint_text: "Professional title"

        MDTextField:
            id: email
            hint_text: "Email"

        MDTextField:
            id: phone
            hint_text: "Phone"

        MDTextField:
            id: location
            hint_text: "Location"

        MDTextField:
            id: website
            hint_text: "Website"

        MDTextField:
            id: linkedin
            hint_text: "LinkedIn"

        MDTextField:
            id: github
            hint_text: "GitHub"

        MDTextField:
            id: summary
            hint_text: "Professional summary"
            multiline: True
            max_height: "120dp"

        MDTextField:
            id: template_name
            hint_text: "Template name"

        MDBoxLayout:
            orientation: "horizontal"
            spacing: "12dp"

            MDRectangleFlatButton:
                text: "Classic"
                on_release: root.apply_template_choice("classic")

            MDRectangleFlatButton:
                text: "Modern"
                on_release: root.apply_template_choice("modern")

        MDTextField:
            id: experience
            hint_text: "Experience"
            multiline: True
            max_height: "120dp"

        MDTextField:
            id: education
            hint_text: "Education"
            multiline: True
            max_height: "120dp"

        MDTextField:
            id: skills
            hint_text: "Skills"
            multiline: True
            max_height: "120dp"

        MDTextField:
            id: languages
            hint_text: "Languages"

        MDTextField:
            id: projects
            hint_text: "Projects"
            multiline: True
            max_height: "120dp"

        MDTextField:
            id: certifications
            hint_text: "Certifications"
            multiline: True
            max_height: "120dp"

        MDTextField:
            id: achievements
            hint_text: "Achievements"
            multiline: True
            max_height: "120dp"

        MDBoxLayout:
            orientation: "horizontal"
            spacing: "12dp"

            MDRectangleFlatButton:
                text: "Experience"
                on_release: root.open_experience_editor()

            MDRectangleFlatButton:
                text: "Education"
                on_release: root.open_education_editor()

            MDRectangleFlatButton:
                text: "Skills"
                on_release: root.open_skills_editor()

        MDBoxLayout:
            orientation: "horizontal"
            spacing: "12dp"

            MDRectangleFlatButton:
                text: "Save JSON"
                on_release: root.save_profile("saved_profile.json")

            MDRectangleFlatButton:
                text: "Load JSON"
                on_release: root.import_profile("saved_profile.json")

            MDRectangleFlatButton:
                text: "Export TXT"
                on_release: root.export_profile("resume_export.txt")

            MDRectangleFlatButton:
                text: "Export PDF"
                on_release: root.export_profile_pdf("resume_export.pdf")

        MDBoxLayout:
            orientation: "horizontal"
            spacing: "12dp"

            MDRectangleFlatButton:
                text: "Improve Resume"
                on_release: root.run_ai_action("improve_resume")

            MDRectangleFlatButton:
                text: "Generate Summary"
                on_release: root.run_ai_action("generate_summary")

            MDRectangleFlatButton:
                text: "Suggest Skills"
                on_release: root.run_ai_action("suggest_skills")

            MDRectangleFlatButton:
                text: "Quality Check"
                on_release: root.run_ai_action("check_quality")

        MDLabel:
            id: ai_feedback
            text: "AI actions are available as future-ready placeholders with mock responses for now."
            halign: "left"
            theme_text_color: "Secondary"
            size_hint_y: None
            height: "72dp"

        MDBoxLayout:
            orientation: "horizontal"
            spacing: "12dp"

            MDRectangleFlatButton:
                text: "Preview Resume"
                on_release: root.preview_resume()

            MDRectangleFlatButton:
                text: "Back to Home"
                on_release: root.manager.current = "home"
