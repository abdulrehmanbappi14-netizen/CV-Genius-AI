#:kivy 2.3.1

<ProfileEditorScreen>:
    MDBoxLayout:
        orientation: "vertical"
        padding: "24dp"
        spacing: "16dp"

        MDLabel:
            text: "Profile Editor"
            halign: "center"
            font_style: "H5"

        MDTextField:
            id: full_name
            hint_text: "Full name"

        MDTextField:
            id: professional_title
            hint_text: "Professional title"

        MDTextField:
            id: email
            hint_text: "Email"

        MDTextField:
            id: phone
            hint_text: "Phone"

        MDTextField:
            id: location
            hint_text: "Location"

        MDTextField:
            id: website
            hint_text: "Website"

        MDTextField:
            id: linkedin
            hint_text: "LinkedIn"

        MDTextField:
            id: github
            hint_text: "GitHub"

        MDTextField:
            id: summary
            hint_text: "Professional summary"
            multiline: True
            max_height: "120dp"

        MDTextField:
            id: template_name
            hint_text: "Template name"

        MDTextField:
            id: experience
            hint_text: "Experience"
            multiline: True
            max_height: "120dp"

        MDTextField:
            id: education
            hint_text: "Education"
            multiline: True
            max_height: "120dp"

        MDTextField:
            id: skills
            hint_text: "Skills"
            multiline: True
            max_height: "120dp"

        MDTextField:
            id: languages
            hint_text: "Languages"

        MDTextField:
            id: projects
            hint_text: "Projects"
            multiline: True
            max_height: "120dp"

        MDTextField:
            id: certifications
            hint_text: "Certifications"
            multiline: True
            max_height: "120dp"

        MDTextField:
            id: achievements
            hint_text: "Achievements"
            multiline: True
            max_height: "120dp"

        MDRectangleFlatButton:
            text: "Preview Resume"
            on_release: root.manager.current = "template_preview"

        MDRectangleFlatButton:
            text: "Back to Home"
            on_release: root.manager.current = "home"
